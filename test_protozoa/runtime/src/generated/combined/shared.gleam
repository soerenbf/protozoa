) -> decode.Decoder(List(NullValue)) {
  use values <- decode.then(decode.repeated_int32(field_num))
  case list.try_map(values, decode_null_value_value) {
    Ok(values) -> decode.success(values)
    Error(err) -> decode.fail("null_value", err, [])
