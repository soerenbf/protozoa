/// Arguments: value. No immediate errors; decoders report errors when run.
/// Example: `encode_state_value(value)`.
pub fn encode_state_value(value: State) -> Int {
  case value {
    Zero -> 0
    First -> 1
    Second -> 2
  }
}

/// Arguments: field_num. Decode errors are returned as Result values.
/// Example: `decode_state_field(field_num)`.
pub fn decode_state_field(field_num: Int) -> decode.Decoder(State) {
  decode.field_with_default(
    field_num,
    fn(field) {
      use value <- result.try(decode.int32_field(field))
      case value {
        0 -> Ok(Zero)
        1 -> Ok(First)
        2 -> Ok(Second)
        _ ->
          Error(
            decode.DecodeError(
              expected: "valid state value",
              found: "Unknown state value: " <> string.inspect(value),
              path: [],
            ),
          )
      }
    },
    Zero,
  )
}

/// Arguments: field. Decode errors are returned as Result values.
/// Example: `decode_state_from_field(field)`.
pub fn decode_state_from_field(
  field: decode.Field,
) -> Result(State, decode.DecodeError) {
  use value <- result.try(decode.int32_field(field))
  case value {
    0 -> Ok(Zero)
    1 -> Ok(First)
    2 -> Ok(Second)
    _ ->
      Error(
        decode.DecodeError(
          expected: "valid state value",
          found: "Unknown state value: " <> string.inspect(value),
          path: [],
        ),
      )
  }
}

/// Arguments: value. Decode errors are returned as Result values.
/// Example: `decode_state_value(value)`.
pub fn decode_state_value(value: Int) -> Result(State, String) {
  case value {
    0 -> Ok(Zero)
    1 -> Ok(First)
    2 -> Ok(Second)
    _ -> Error("Unknown state value: " <> int.to_string(value))
  }
}

/// Arguments: field_num. Decode errors are returned as Result values.
/// Example: `decode_repeated_state(field_num)`.
pub fn decode_repeated_state(field_num: Int) -> decode.Decoder(List(State)) {
  use values <- decode.then(decode.repeated_int32(field_num))
  case list.try_map(values, decode_state_value) {
    Ok(values) -> decode.success(values)
    Error(err) -> decode.fail("state", err, [])
  }
}
